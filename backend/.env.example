# Copiez ce fichier vers .env puis adaptez les valeurs :
#   cp backend/.env.example backend/.env
#
# Le fichier .env ne doit JAMAIS être commité (il est ignoré par .gitignore).

# --- Base de données (obligatoire) ---
# Format : mysql+pymysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=mysql+pymysql://insti_user:changez_moi@localhost:3306/insti_labs

# --- Sécurité (recommandé) ---
# Valeur à générer avec : openssl rand -hex 32
# Note : main.py utilise actuellement une clé codée en dur ; branchez cette
# variable via os.getenv("SECRET_KEY") avant la mise en production.
SECRET_KEY=changez_cette_cle_secrete
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Divers ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
