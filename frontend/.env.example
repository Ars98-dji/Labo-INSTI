# Copiez ce fichier vers .env puis adaptez les valeurs :
#   cp frontend/.env.example frontend/.env
#
# Le fichier .env ne doit JAMAIS être commité (il est ignoré par .gitignore).

# URL de base de l'API FastAPI (sans slash final)
REACT_APP_API_BASE=http://localhost:8000/api/v1

# true = utiliser les données de démonstration locales (src/data/demoLabs.js)
# sans avoir besoin de lancer le backend. false = utiliser l'API.
REACT_APP_USE_DEMO_DATA=false
